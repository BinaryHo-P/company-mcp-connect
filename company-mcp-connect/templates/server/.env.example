# ─────────────────────────────────────────────
# MCP 서버 설정. 이 파일을 .env 로 복사해 채운다.  cp .env.example .env
# ⛔ .env 는 저장소에 올리지 않는다(.gitignore 에 있음). 비밀번호는 여기에만 둔다.
# 전체 목록과 클라우드별 예시: references/adapters.md
# ─────────────────────────────────────────────

MCP_COMPANY_NAME=새봄인테리어

# ── DB ── postgres | mysql | sqlserver
MCP_DB_KIND=postgres
# password | gcp-iam | aws-iam | azure-ad   (클라우드 DB 는 비밀번호 대신 클라우드 계정 인증 권장)
MCP_DB_AUTH=password

# password 인증: 권한 축소 롤의 주소 (관리자 계정이면 서버가 뜨지 않는다)
MCP_DB_URL=postgres://mcp_reader:demo-only-change-me@localhost:55432/saebom
# 사내 서버 등 localhost 가 아닌 곳에 비밀번호로 붙어야 할 때만 1
# MCP_DB_PASSWORD_REMOTE_OK=1

# 클라우드 인증일 때 (adapters.md 3-2 ~ 3-4)
# MCP_DB_USER=manager@example.com
# MCP_DB_NAME=saebom
# MCP_GCP_INSTANCE=saebom-prod:asia-northeast3:saebom-db
# MCP_DB_HOST=
# MCP_DB_PORT=
# MCP_AWS_REGION=ap-northeast-2
# MCP_DB_SSL_CA=/절대경로/rds-global-bundle.pem

# 이 롤로 "읽을 수 없어야 하는" 원본 표. 기동할 때마다 정말 막혔는지 확인한다.
MCP_ISOLATION_PROBE=app.customer

# ── 문서 저장소 ── none | local | gcs | s3 | azure
MCP_STORAGE_KIND=local
MCP_STORAGE_ROOT=./demo/manuals
# MCP_STORAGE_PREFIX=manuals/
# MCP_STORAGE_EXT=.md,.txt
# MCP_S3_REGION=ap-northeast-2
# MCP_AZURE_ACCOUNT_URL=https://<계정>.blob.core.windows.net

# ── 쓰기 ── 기본 꺼짐. 켜려면 둘 다 (클라우드 인증이면 ACTOR 는 접속 계정에서 자동)
# MCP_ENABLE_WRITES=1
# MCP_ACTOR=manager@example.com

# ── 기록 위치 ── 기본 ~/.local/state/company-mcp
# MCP_STATE_DIR=
# MCP_AUDIT_LOG=
